{
  "name": "mbse-mbple-workbench",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:semantic-performance": "vitest run --config vitest.semantic-performance.config.ts"
  },
  "dependencies": {
    "@xyflow/react": "12.8.2",
    "elkjs": "^0.12.0",
    "jspdf": "4.2.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.0",
    "write-excel-file": "4.1.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "24.13.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "fflate": "0.8.3",
    "jsdom": "25.0.1",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
